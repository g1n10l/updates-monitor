        "opdata": "Aktualna liczba pakietów: {ITEM.LASTVALUE1}",
        "priority": "DISASTER",
        "description": "Problem zamyka się po udanym sprawdzeniu, które wykazało zero w tej grupie.",
        "event_name": "Dostępne aktualizacje kernela ({ITEM.VALUE1})"
      },
      {
        "uuid": "fec7454b52dd44dea8d0b55ea11e832c",
        "expression": "max(/Updates monitor Debian Ubuntu/updates.monitor.valid,2m)=0 and last(/Updates monitor Debian Ubuntu/updates.monitor.health.valid)=1 and (last(/Updates monitor Debian Ubuntu/updates.monitor.health.service_state)=0 or last(/Updates monitor Debian Ubuntu/updates.monitor.health.service_state)=4)",
        "name": "Nie powiodło się sprawdzanie aktualizacji",
        "priority": "WARNING",
        "description": "Brak poprawnej kontroli przez co najmniej 2 minuty; alarm jest wstrzymany, gdy kontrola trwa."
      },
      {
        "uuid": "5c73a595e4624a07923e8859fb949c14",
        "expression": "nodata(/Updates monitor Debian Ubuntu/updates.monitor.raw,10m)=1",
        "name": "Brak danych monitora aktualizacji przez 10 minut",
        "priority": "WARNING",
        "description": "Sprawdź połączenie z agentem i jego konfigurację."
      },
      {
        "uuid": "10fc6a8aa8614368938d59a1e81ad809",
        "name": "Harmonogram sprawdzania aktualizacji jest wyłączony",
        "expression": "last(/Updates monitor Debian Ubuntu/updates.monitor.health.valid)=1 and last(/Updates monitor Debian Ubuntu/updates.monitor.health.scheduler_active)=0",
        "priority": "WARNING"
      },
      {
        "uuid": "666ffc0fbeb54f6f97240876e497447d",
        "name": "Usługa sprawdzania aktualizacji zakończyła się błędem",
        "expression": "last(/Updates monitor Debian Ubuntu/updates.monitor.health.valid)=1 and last(/Updates monitor Debian Ubuntu/updates.monitor.health.service_failed)=1",
        "priority": "WARNING"
      },
      {
        "uuid": "d8c81d3162ac4fd2b79e522c8c9e640a",
        "name": "Brak aktualnego stanu harmonogramu aktualizacji",
        "expression": "max(/Updates monitor Debian Ubuntu/updates.monitor.health.valid,3m)=0 or nodata(/Updates monitor Debian Ubuntu/updates.monitor.health,5m)=1 or (last(/Updates monitor Debian Ubuntu/updates.monitor.health.updated_at)>0 and now()-last(/Updates monitor Debian Ubuntu/updates.monitor.health.updated_at)>180)",
        "priority": "WARNING"
      },
      {
        "uuid": "d5305b01e2bf47c3b12d19138b119bb0",
        "name": "Wynik sprawdzania aktualizacji jest nieaktualny",
        "expression": "last(/Updates monitor Debian Ubuntu/updates.monitor.health.valid)=1 and last(/Updates monitor Debian Ubuntu/updates.monitor.health.scheduler_active)=1 and last(/Updates monitor Debian Ubuntu/updates.monitor.checked_at)>0 and now()-last(/Updates monitor Debian Ubuntu/updates.monitor.checked_at)>last(/Updates monitor Debian Ubuntu/updates.monitor.health.interval_seconds)+1200",
        "priority": "WARNING"
      }
