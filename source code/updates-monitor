#!/bin/bash
set -euo pipefail
[[ $EUID == 0 ]] || { echo 'Wymagane uprawnienia root.' >&2; exit 1; }
scheduler=/usr/local/lib/updates-monitor/scheduler.py
if [[ $# == 1 && $1 == status ]]; then
    echo 'Trwa sprawdzanie aktualizacji...'
    result=0
    service_failed=0
    if ! systemctl start updates-monitor.service; then
        echo 'Kontrola nie powiodła się. Szczegóły: journalctl -u updates-monitor.service -n 50 --no-pager' >&2
        result=1
        service_failed=1
    fi
    # Sprawdź oba źródła bez oczekiwania na kolejny przebieg cron.
    reboot_data=$($scheduler reboot-status) || reboot_data='{}'
    service_state=$(systemctl is-active updates-monitor.service || true)
    cron_state=$(systemctl is-active cron.service || true)
    cron_enabled=$(systemctl is-enabled cron.service 2>/dev/null || true)
    schedule=$($scheduler show) || { schedule='{}'; result=1; }
    terminal_color=0
    [[ -t 1 && ${TERM:-dumb} != dumb && -z ${NO_COLOR:-} ]] && terminal_color=1
    if ! /usr/bin/python3 - "$reboot_data" "$schedule" "$service_state" "$cron_state" "$cron_enabled" "$terminal_color" <<'PYCODE'
import datetime
import json
import socket
import sys

def read_json(value):
    try:
        data = json.loads(value)
        return data if isinstance(data, dict) else {}
    except (ValueError, TypeError):
        return {}

reboot, schedule = map(read_json, sys.argv[1:3])
service, cron, cron_enabled, color = sys.argv[3:7]
try:
    with open('/run/updates-monitor/state.json', encoding='utf-8') as f:
        data = json.load(f)
    counts = [data[k] for k in ('regular', 'security', 'kernel_security')]
    if any(type(n) is not int or n < 0 for n in counts):
        raise ValueError('nieprawidłowe liczniki')
    ts = int(data.get('checked_at', 0))
    checked = datetime.datetime.fromtimestamp(ts).astimezone().strftime('%d.%m.%Y %H:%M %Z') if ts else 'brak'
    valid = data.get('valid') == 1
except (OSError, ValueError, KeyError, TypeError, OverflowError) as exc:
    print('Nie można odczytać wyniku:', exc, file=sys.stderr)
    sys.exit(1)
print('\nUPDATES MONITOR  ' + socket.gethostname())
print('-----------------------------------------------')
print('Ostatnia kontrola: ' + checked)
print('Wynik kontroli:    ' + ('poprawny' if valid else 'nieaktualny'))
print('\nAKTUALIZACJE - SUMY KONTROLI')
for label, count in zip(('Regularne', 'Bezpieczeństwa', 'Kernel'), counts):
    print('  {:20} {}'.format(label + ':', count))
values = [reboot.get('reboot_required'), reboot.get('kernel_update_pending')]
print('\nRESTART')
if 1 in values:
    message = 'wymagany restart systemu'
    if color == '1':
        message = '\033[5;31m' + message + '\033[0m'
    print('  ' + message)
elif values == [0, 0]:
    print('  Restart niewymagany')
else:
    print('  Stan nieznany')
print('\nHARMONOGRAM')
print('  Stan:       ' + ('włączony' if schedule.get('enabled') is True else 'wyłączony' if schedule.get('enabled') is False else 'nieznany'))
print('  Interwał:   ' + str(schedule.get('interval', 'nieznany')))
print('  Cron:       ' + cron + ' (autostart: ' + cron_enabled + ')')
print('  Usługa:     ' + service)
if not valid:
    sys.exit(1)
PYCODE
    then
        result=1
    fi
    if [[ $service_failed == 1 ]]; then
        echo
        echo 'Ostatnie błędy usługi (do 10 wpisów z journalctl, także z poprzednich uruchomień):'
        if log=$(journalctl -u updates-monitor.service -p err -n 10 --no-pager --quiet -o short-iso 2>&1); then
            if [[ -n $log ]]; then printf '%s\n' "$log"; else echo 'Brak zapisanych błędów.'; fi
        else
            echo 'Nie można odczytać dziennika usługi.' >&2
            [[ -z $log ]] || printf '%s\n' "$log" >&2
            result=1
        fi
    fi
    exit "$result"
fi
[[ $# == 2 && $1 == interval ]] || { echo 'Użycie: updates-monitor status | interval {2h|6h|12h|1D|5D|10D|15D}' >&2; exit 2; }
case "$2" in 2h|6h|12h|1D|5D|10D|15D) ;; *) echo 'Nieobsługiwany interwał.' >&2; exit 2;; esac
"$scheduler" interval "$2"
systemctl start --no-block updates-monitor-scheduler.service
echo "Interwał ustawiony: $2"
